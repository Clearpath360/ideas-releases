<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="6dp">
    <TextView android:id="@+id/w_open"
        android:layout_width="wrap_content" android:layout_height="match_parent"
        android:gravity="center" android:paddingStart="12dp" android:paddingEnd="10dp"
        android:text="E" android:textSize="22sp" android:textStyle="bold" android:textColor="#1F6F5C"
        android:fontFamily="serif" />
    <TextView android:id="@+id/w_voice"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
        android:background="@drawable/widget_btn" android:gravity="center"
        android:text="🎤  Record idea" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/w_type"
        android:layout_width="52dp" android:layout_height="match_parent"
        android:gravity="center" android:text="✎" android:textSize="22sp" android:textColor="#1C2230" />
</LinearLayout>
